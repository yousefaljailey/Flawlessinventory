# ── WhatsApp auto-notifications (CallMeBot — free) ───────────────────────────
# 1. Save +33758033774 in your phone contacts as "CallMeBot"
# 2. Send "I allow callmebot to send me messages" to that contact on WhatsApp
# 3. You'll receive your API key by WhatsApp — paste it below
# Without this key, a manual WhatsApp button appears after each save instead.
WA_API_KEY=your-callmebot-api-key

# ── Email (required for report sending) ──────────────────────────────────────
# Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ── Vercel KV (required for persistent storage on Vercel) ────────────────────
# In Vercel dashboard → Storage → Create KV → Link to project
# Vercel adds these automatically once linked:
KV_REST_API_URL=https://your-kv.kv.vercel-storage.com
KV_REST_API_TOKEN=your-token-here

# ── Vercel Cron secret (optional but recommended) ────────────────────────────
# Set any random string. Add same value to Vercel env vars as CRON_SECRET.
CRON_SECRET=change-me-to-something-random

# ── Local dev ─────────────────────────────────────────────────────────────────
PORT=3001
